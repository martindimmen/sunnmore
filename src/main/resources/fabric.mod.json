{
	"schemaVersion": 1,
	"id": "sunnmore",
	"version": "${version}",
	"name": "Sunnmøre",
	"description": "A pack of small, silly mods built around our friends.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/sunnmore/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"martidi.sunnmore.Sunnmore"
		],
		"client": [
			"martidi.sunnmore.client.SunnmoreClient"
		]
	},
	"mixins": [
		"sunnmore.mixins.json",
		{
			"config": "sunnmore.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}